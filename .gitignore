# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Node (해당 시) ----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- 환경변수 / 시크릿 ----
.env
.env.*
!.env.example

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform.lock.hcl

# job별 격리 실행 디렉터리 및 provider plugin 캐시(app/services/provisioning) — 런타임 산출물
backend/terraform/.runs/
backend/terraform/.plugin-cache/

# ---- 로그 ----
# 디렉터리 자체는 유지한다(docker-compose가 ./logs를 컨테이너에 바인드 마운트한다).
logs/*
!logs/.gitkeep
backend/logs/
*.log
*.log.[0-9]

# ---- OS / 편집기 잡파일 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
