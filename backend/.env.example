DATABASE_URL=postgresql+psycopg2://mcp_user:change_me@db:5432/mcp_db
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mcp_db
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# 프로비저닝(Terraform) 실행 경로 — backend/terraform/README.md 참고
TERRAFORM_MODULES_DIR=terraform
TERRAFORM_RUNS_DIR=terraform/.runs
TERRAFORM_TIMEOUT_SECONDS=900
TERRAFORM_PLUGIN_CACHE_DIR=terraform/.plugin-cache
