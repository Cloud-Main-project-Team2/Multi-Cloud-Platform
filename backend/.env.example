DATABASE_URL=postgresql+psycopg2://mcp_user:change_me@db:5432/mcp_db
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mcp_db
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# 프로비저닝(Terraform) 실행 경로 — backend/terraform/README.md 참고
TERRAFORM_MODULES_DIR=terraform
TERRAFORM_RUNS_DIR=terraform/.runs
TERRAFORM_TIMEOUT_SECONDS=900
TERRAFORM_PLUGIN_CACHE_DIR=terraform/.plugin-cache

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600
REFRESH_TOKEN_EXPIRES_SECONDS=1209600

# 메일 발송(app/mailer.py) — 로컬/데모는 docker-compose의 MailHog를 그대로 쓴다.
# MailHog는 인증·TLS가 없으므로 MAIL_USERNAME/PASSWORD는 비워 둔다. 운영은 실제 SMTP로 교체.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@multicloud.example
MAIL_USE_TLS=false
# 이메일 검증·비밀번호 재설정 링크가 가리킬 프론트 오리진.
FRONTEND_BASE_URL=http://localhost:8080
# 이메일 검증(OTP) 파라미터.
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFICATION_VALID_WINDOW_SECONDS=1800
# 비밀번호 재설정 링크 토큰 만료.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
# app/terraform_runner.py — docker-compose.yml은 /app/terraform_workspaces·/app/terraform_plugin_cache로
# 덮어쓴다(볼륨 마운트 경로). 컨테이너 밖에서 직접 uvicorn을 띄울 때만 아래 기본값(/tmp)이 쓰인다.
TERRAFORM_BINARY_PATH=terraform
TERRAFORM_WORKSPACES_DIR=/tmp/terraform-workspaces
TERRAFORM_PLUGIN_CACHE_DIR=/tmp/terraform-plugin-cache
TERRAFORM_APPLY_TIMEOUT_SECONDS=900

# app/agent.py — AI 비용 어시스턴트(POST /agent/chat, OpenAI Chat Completions API). 비워두면
# 503(AGENT_NOT_CONFIGURED)을 반환할 뿐 나머지 기능엔 영향 없다. 실제 키는 여기(예시 파일)에
# 절대 커밋하지 말 것 — 각자 backend/.env(git 추적 안 됨)에만 넣는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# app/providers/session.py — AWS 역할 위임(AssumeRole)을 호출할 "출발 신원". 우리 서비스 자신의
# AWS 신원이며 사용자에게 받는 값이 아니다. 비워두면 위임 방식 credential만 쓸 수 없고 기존
# access key 방식은 그대로 동작한다. 서버를 AWS 위(EC2/ECS 역할)에 올리면 키 두 개를 비우고
# boto3 기본 자격증명 체인에 맡기면 장기 키가 완전히 사라진다.
# 실제 키는 이 예시 파일에 절대 커밋하지 말 것 — 각자 .env(git 추적 안 됨)에만 넣는다.
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
# 우리 플랫폼 키가 빌릴 수 있는 역할 ARN 패턴(IAM 정책의 Resource와 같은 값).
PLATFORM_AWS_ASSUMABLE_ROLE_PATTERN=arn:aws:iam::*:role/MultiCloudOps*
# AssumeRole 세션 수명(초). 역할의 MaxSessionDuration 이하여야 하고, terraform apply
# 타임아웃(900초)보다는 충분히 길어야 한다.
PLATFORM_AWS_SESSION_DURATION_SECONDS=3600

# ── 비용 수집 활성화(app/cost/gating.py) ────────────────────────────────────────────
# 어댑터 등록은 "구현 지원"일 뿐이고 실제 CSP 호출 여부는 아래가 정한다. 기본값은 aws뿐이라
# Azure·GCP 어댑터가 생겨도 호출은 0건이다. 수동과 자동은 독립이다.
COST_INGEST_PROVIDERS=aws
COST_AUTO_INGEST_PROVIDERS=aws
# azure·gcp는 계정을 명시해야 켜진다(비어 있으면 그 provider는 한 계정도 수집하지 않는다).
# 예: COST_INGEST_ACCOUNT_IDS=azure:42,gcp:7
COST_INGEST_ACCOUNT_IDS=

# GCP 비용 수집(app/cost/gcp_cost.py)은 BigQuery 청구 Export 테이블을 읽는다.
# "<project_id>:<프로젝트.데이터셋.테이블>" 목록(쉼표 구분). 비어 있으면 그 계정은 수집하지 않는다.
# 예: COST_GCP_EXPORT_TABLES=my-project:billing-proj.billing.gcp_billing_export_v1_0123AB_CDEF45
COST_GCP_EXPORT_TABLES=
# 스캔 바이트 상한(=과금 상한). 실행 전 dry-run 예상치가 이 값을 넘으면 쿼리를 보내지 않는다.
COST_GCP_MAX_SCANNED_BYTES=2147483648
COST_GCP_QUERY_TIMEOUT_SECONDS=120
